PORT=3001

# Секрет підпису JWT (≥16 символів). Згенеруй випадковий рядок, не публікуй.
ADMIN_JWT_SECRET=заміни_на_довгий_випадковий_секрет

# Адміністратори: пари email / пароль (ADMIN_LOGIN_1_…, _2_…, … до 32).
ADMIN_LOGIN_1_EMAIL=admin@example.com
ADMIN_LOGIN_1_PASSWORD=your_password
# ADMIN_LOGIN_2_EMAIL=
# ADMIN_LOGIN_2_PASSWORD=

# Якщо 3001 зайнятий — зміни PORT і в корені .env.local: VITE_API_URL=http://127.0.0.1:3002
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
