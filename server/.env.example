PORT=3001
# Довгий секрет (≥8 символів). Перегляд замовлень: на сайті відкрий #admin і введи цей токен.
ADMIN_TOKEN=заміни_на_довгий_випадковий_рядок

# Якщо 3001 зайнятий — зміни PORT (наприклад 3002) і додай у корені .env.local:
# VITE_API_URL=http://127.0.0.1:3002
# Через кому:
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
